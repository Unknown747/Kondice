modules = ["python-3.12", "bash"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Dice Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Scheduler"

[[workflows.workflow]]
name = "Run Dice Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python dice_bot.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Scheduler"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scheduler.py"

[workflows.workflow.metadata]
outputType = "console"
